# サーバーではホームディレクトリがGitのルートになるため、登録対象を限定する。
/*
!/.gitignore
!/env.sh
!/Taskfile.yml
!/scripts/
!/webapp/

# Go・Node.jsの実装と共通ファイルを管理する。
/webapp/*
!/webapp/go/
!/webapp/nodejs/
!/webapp/payment_mock/
!/webapp/public/
!/webapp/sql/
!/webapp/openapi.yaml

# 各言語の.gitignoreに加え、共通のローカルファイルを除外する。
.DS_Store
node_modules/
*.log
.env
.env.*

# MySQL・nginxの設定ファイルを管理する。
!/common/
/common/**
!/common/**/
!/common/etc/mysql/mysql.conf.d/mysqld.cnf
!/common/etc/nginx/nginx.conf
!/common/etc/nginx/sites-available/isuride.conf

# Makefileはビルドに必要なため、除外しない。
!/Makefile